rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==========================================================================
       ADMINS DEL PANEL
       Los admins ya NO estan escritos aca: viven en la coleccion /admins, un
       documento por mail, y se agregan desde el panel (Configuracion -> Admins).
       Antes agregar a alguien eran cuatro archivos y dos deploys, y era facil
       tocar solo uno: la persona veia la pantalla y no podia escribir nada, o
       directamente no pasaba el login.

       EL DUEÑO QUEDA FIJO ACA A PROPOSITO. Es la salida de emergencia: si alguien
       borra todos los documentos de /admins, o se equivoca y se saca a si mismo,
       sin esto nadie podria volver a entrar a arreglarlo. No se puede quitar
       desde el panel ni borrar su documento.
       ========================================================================== */
    function esDuenio() {
      return request.auth != null
        && request.auth.token.email.lower() == 'jeroobregon03@gmail.com';
    }

    function mailPropio() {
      return request.auth != null ? request.auth.token.email.lower() : '';
    }

    /* Los 4 mails que YERCO ya tenia habilitados siguen valiendo como respaldo,
       ademas de la coleccion /admins. Sin esto, mover los admins a Firestore los
       dejaba afuera del panel hasta que alguien cargara la coleccion a mano.
       Cuando esten todos dados de alta desde Configuracion -> Admins, esta lista
       se puede borrar y queda solo /admins mas el duenio. */
    function esAdminHeredado() {
      return request.auth != null && (
        mailPropio() == 'obregonjeronimo@icloud.com' ||
        mailPropio() == 'genaro077caromaggi@gmail.com' ||
        mailPropio() == 'agustinmarqez2@gmail.com' ||
        mailPropio() == 'joacobrarda06@gmail.com'
      );
    }

    function isAdmin() {
      return esDuenio()
        || esAdminHeredado()
        || (request.auth != null
            && exists(/databases/$(database)/documents/admins/$(mailPropio())));
    }

    /* ===== ADMINS =====
       El id del documento es el mail en minusculas. `get` esta abierto solo al
       propio mail: asi el panel puede preguntar "¿soy admin?" sin que un cliente
       logueado pueda enumerar quienes son. Listar la coleccion completa, en
       cambio, sigue siendo solo para admins. */
    match /admins/{mail} {
      allow get: if request.auth != null && mailPropio() == mail;
      allow list: if isAdmin();
      /* Se exige el mail en minusculas para que el id coincida siempre con lo que
         devuelve el token, que es como se resuelve isAdmin(). */
      allow create, update: if isAdmin()
        && mail == mail.lower()
        && mail.matches('^[^@/]+@[^@/]+[.][^@/]+$')
        && mail != 'jeroobregon03@gmail.com';
      /* Nadie puede borrar al dueño, ni borrarse a si mismo (evita quedar afuera
         con un click). */
      allow delete: if isAdmin()
        && mail != 'jeroobregon03@gmail.com'
        && mailPropio() != mail;
    }

    function isAuthUser() {
      return request.auth != null;
    }

    function validString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    /* ===== PRODUCTOS ===== */
    match /productos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===== PEDIDOS ===== */
    match /pedidos/{doc} {
      /* Crear: el panel, o un cliente logueado con la forma de un pedido web.
         La rama de admin faltaba y el create se rechazaba SIEMPRE desde el panel:
         Pedidos > Nuevo Pedido arma un pedido de mostrador, que no lleva
         origen 'web' y puede no traer telefono. El boton nunca funciono, y
         encima el numero sale de una transaccion que commitea ANTES del add:
         cada intento quemaba un numero de pedido que despues faltaba en la
         numeracion de la web. */
      allow create: if isAdmin()
        || (isAuthUser()
        && request.resource.data.keys().hasAll(['cliente','telefono','items','total','origen','estado','creadoEn'])
        && validString(request.resource.data.cliente, 120)
        && validString(request.resource.data.telefono, 30)
        && request.resource.data.total is number
        /* >= 0 y no > 0: un cupon de monto fijo puede cubrir el carrito entero y, con
           retiro en local, el total da exactamente 0. Ese pedido es legitimo y la regla
           lo rechazaba; como confirmCheckout() se come el error del add(), el cliente
           veia "Pedido confirmado", el mensaje salia por WhatsApp y en el panel no
           aparecia nada, con el numero de pedido ya consumido. */
        && request.resource.data.total >= 0
        && request.resource.data.total < 10000000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        /* 100 lineas se alcanzan: el carrito no tiene tope y sobrevive en localStorage,
           asi que un mayorista las junta sin darse cuenta. Mismo final silencioso que
           arriba. 300 sigue acotando el abuso sin tirar pedidos de verdad. */
        && request.resource.data.items.size() <= 300
        && request.resource.data.origen == 'web');
      /* Leer: admin o el propio cliente */
      allow read: if isAdmin()
        || (isAuthUser() && 'clienteAuthUid' in resource.data && resource.data.clienteAuthUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ===== VENTAS ===== */
    match /ventas/{doc} {
      allow read, write: if isAdmin();
    }
    match /ventasMayoristas/{doc} {
      allow read, write: if isAdmin();
    }

    /* ===== CLIENTES ===== */
    match /clientes/{doc} {
      allow read, write: if isAdmin();
    }

    /* ===== CLIENTES AUTH ===== */
    match /clientesAuth/{uid} {
      allow read: if isAdmin() || (isAuthUser() && request.auth.uid == uid);
      allow create: if isAuthUser() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email','nombre','apellido','telefono','direcciones','creadoEn'])
        && validString(request.resource.data.email, 200)
        && validString(request.resource.data.nombre, 80)
        && validString(request.resource.data.apellido, 80)
        && validString(request.resource.data.telefono, 30)
        && request.resource.data.direcciones is list
        && request.resource.data.direcciones.size() <= 5;
      /* El cliente solo puede tocar sus cuatro campos de perfil. Antes la regla validaba
         el CONTENIDO de esos cuatro pero no limitaba QUE campos se podian escribir, asi
         que cualquiera logueado podia agregarse un clienteId con HTML adentro:
           .update({clienteId:'<img src=x onerror=...>'})
         y el panel lo metia en innerHTML sin escapar al listar clientes y pedidos. Era XSS
         almacenado contra el admin, disparable por cualquier cliente de la tienda.
         clienteId es el vinculo con la coleccion clientes y lo asigna el admin: no tiene
         por que poder escribirlo el cliente. */
      allow update: if isAdmin()
        || (isAuthUser() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombre','apellido','telefono','direcciones'])
          && (!('nombre' in request.resource.data) || validString(request.resource.data.nombre, 80))
          && (!('apellido' in request.resource.data) || validString(request.resource.data.apellido, 80))
          && (!('telefono' in request.resource.data) || validString(request.resource.data.telefono, 30))
          && (!('direcciones' in request.resource.data) || (request.resource.data.direcciones is list && request.resource.data.direcciones.size() <= 5)))
      /* Las metricas del panel. _onUserLogin() escribe estos dos campos en el primer
         acceso de cada dia, y la regla de arriba los rechazaba: solo deja pasar los
         cuatro campos de perfil. El error se lo comia el .catch() de al lado, asi que
         en el panel todo cliente que entra por la web quedaba con visitas:1 y el
         ultimo acceso clavado en la fecha del alta, desde siempre.
         Se permite el paso EXACTO que hace la tienda, con el mismo criterio que
         pedidosCount: el timestamp lo pone el servidor (no lo elige el cliente) y
         visitas solo puede subir de a uno. Asi nadie se inventa el numero de visitas
         ni antedata su ultimo acceso. Los cuatro campos de perfil siguen yendo por la
         rama de arriba: un mismo write no puede mezclar perfil y metricas. */
      || (isAuthUser() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['ultimoAcceso','visitas'])
          && request.resource.data.ultimoAcceso == request.time
          && request.resource.data.visitas == resource.data.get('visitas', 0) + 1);
    }

    /* ===== CUPONES ===== */
    match /cupones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cuponesUsos/{doc} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      /* Sin exigir sesion alcanzaba con OMITIR el campo uid para escribir aca sin estar
         logueado. Como /cupones se lee sin login, cualquiera podia listar los cupones con su
         maxUsos desde la consola del navegador y hacer creates en loop: la Cloud Function
         procesarUsoCupon cuenta cada uno y al llegar al maximo pone el cupon en activo:false,
         asi que con 50 escrituras se mataba una promocion y los clientes de verdad se
         encontraban con "cupon vencido". El canje de invitado no se pierde: comprar ya exige
         sesion (requireLoginToBuy), asi que todo uso real trae uid. */
      allow create: if isAuthUser()
        && request.resource.data.uid == request.auth.uid
        && validString(request.resource.data.codigo, 30);
    }

    /* ===== CONFIG =====
       config/telegram guarda el TOKEN del bot. El resto de los documentos de
       config/ son contenido publico (textos de la web, datos de la factura,
       contadores) y la tienda los necesita leer sin login.

       IMPORTANTE - por que la exclusion va ACA ADENTRO y no en un match aparte:
       en Firestore las reglas de todos los match que coinciden se combinan con
       OR. Un match mas especifico NO pisa al generico: solo puede SUMAR permisos,
       nunca quitarlos. Si dejas `match /config/{doc} { allow read: if true }` y
       agregas un `match /config/telegram { allow read: if isAdmin() }`, el token
       sigue siendo publico, porque la primera regla ya lo permitio.

       Esto no rompe nada:
         - la Cloud Function usa el Admin SDK y no pasa por estas reglas
         - el panel /admin lo lee logueado como admin
       Mas seguro todavia (ver SETUP.md): mover el token a Secret Manager con
       defineSecret() y sacarlo de Firestore por completo. */
    match /config/{doc} {
      allow read: if doc != 'telegram' || isAdmin();
      /* Los dos contadores tienen que seguir siendo escribibles por el cliente logueado
         (el numero de pedido y el de cliente salen de una transaccion hecha en la tienda),
         pero antes la regla no miraba el contenido: cualquiera con una cuenta de Google
         podia hacer set({count:0}) y los pedidos web volvian a numerarse desde 1, pisando
         numeros que ya existian en el panel, o dejar el contador en 999999999. Ahora solo
         se acepta EXACTAMENTE el paso que hace la tienda: un unico campo count, numerico,
         y siempre el anterior + 1 (o 1 si el documento todavia no existe). */
      allow write: if isAdmin()
        || ((doc == 'pedidosCount' || doc == 'clientesAuthCount')
            && isAuthUser()
            && request.resource.data.keys().hasOnly(['count'])
            && request.resource.data.count is number
            && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1));
    }

    /* ===== RESEÑAS ===== */
    match /resenas/{doc} {
      allow read: if true;
      /* Solo el admin puede crear tokens de reseña */
      allow create: if isAdmin();
      /* El cliente puede completar una reseña (update) si el token existe y no fue usado.
         No puede alterar ventaNum ni creadoEn (preserva la integridad del token).

         ENDURECIDO respecto de YERCO: ahí este update NO pedía autenticación.
         Como `read` es público, los ids de los tokens se pueden listar, así que
         cualquiera podía completar la reseña de otro (el login de resena.html es
         solo del lado del cliente y se saltea desde la consola).
         Ahora exigimos sesión y que clienteAuthUid sea el del que escribe, que es
         exactamente lo que resena.html ya manda. */
      /* Ademas: si el token nacio atado a una cuenta, SOLO esa cuenta lo puede completar.
         Antes alcanzaba con estampar el propio uid, que es lo que manda resena.html: como
         `read` es publico, cualquiera lista los tokens pendientes y una sola cuenta podia
         completar las 40 resenas abiertas con una estrella. Los tickets de mostrador sin
         cuenta no traen el campo y siguen funcionando como antes. */
      /* El admin solo puede tocar `visible`, que es lo unico que hace el boton
         Ocultar/Mostrar del panel. Sin esta rama el update se rechazaba y el
         dueño no tenia forma de bajar una resena mala: resena.html las publica
         con visible:true y la tienda muestra todo lo que tenga visible==true,
         asi que la unica salida era borrarla. Acotado a esa sola clave para que
         el panel no pueda reescribir lo que el cliente opino. */
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible'])
          && request.resource.data.visible is bool)
        || (isAuthUser()
        && request.resource.data.clienteAuthUid == request.auth.uid
        && (!('clienteAuthUid' in resource.data)
            || resource.data.clienteAuthUid == null
            || resource.data.clienteAuthUid == request.auth.uid)
        && resource.data.usado == false
        && request.resource.data.usado == true
        && request.resource.data.ventaNum == resource.data.ventaNum
        && validString(request.resource.data.nombre, 100)
        && validString(request.resource.data.comentario, 1000)
        && request.resource.data.estrellas is number
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5);
      allow delete: if isAdmin();
    }

    /* ===== HISTORIAL ===== */
    match /historial/{doc} {
      allow read, write: if isAdmin();
    }

    /* ===== SITE CONTENT =====
       NOTA: siteContent y factura son DOCUMENTOS dentro de config/, no colecciones.
       Su acceso está cubierto por la regla config/{doc}. Estos match no aplican
       pero se dejan documentados por claridad. */
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===== LISTAS PROVEEDORES ===== */
    match /listas/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===== INSUMOS ===== */
    match /insumos/{doc} {
      allow read, write: if isAdmin();
    }

    /* ===== FACTURA ===== */
    match /factura/{doc} {
      allow read, write: if isAdmin();
    }

    /* ===== CATEGORIAS ===== */
    match /_categorias/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
